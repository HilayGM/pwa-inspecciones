{
  "name": "pwa-inspecciones-laboratorio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node tests/starter.spec.mjs && tsx tests/manifest.spec.ts && npm run test:unit && npm run test:integration && npm run test:capabilities && npm run test:service-worker && npm run test:rendering && npm run test:e2e",
    "verify": "node scripts/verify.mjs",
    "test:unit": "tsx --test tests/unit/sync-logic.spec.ts tests/unit/device-adapters.spec.ts",
    "test:integration": "tsx --test tests/sync.spec.ts tests/integration/inspections-api.spec.ts",
    "test:e2e": "playwright test tests/e2e/ tests/offline.spec.ts",
    "test:service-worker": "tsx tests/service-worker.spec.ts",
    "test:offline": "playwright test tests/offline.spec.ts",
    "test:rendering": "tsx tests/rendering.spec.ts",
    "test:sync": "tsx --test tests/sync.spec.ts",
    "test:capabilities": "tsx --test tests/capabilities.spec.ts"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5"
  }
}
